# Copy to api/.env (not committed) or export these before `npm run dev:api`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mealplanner
PORT=8080
# Comma-separated origins of the static web app allowed to call the API.
WEB_ORIGIN=http://localhost:5173
# Set to false to run `npm run db:migrate` yourself instead of on start-up.
MIGRATE_ON_START=true
# OAuth client id from Google Cloud Console (APIs & Services > Credentials). Leave unset to turn Google sign-in off.
GOOGLE_CLIENT_ID=
# Anthropic API key (console.anthropic.com > API keys). Lets the API read recipe pages with Claude when a
# favourite is added, and restaurant pages (cuisine, address, booking link) when a restaurant's link is given.
# Leave unset to turn it off; people then type those details in themselves.
ANTHROPIC_API_KEY=
# Google Maps Platform API key with "Places API (New)" enabled (console.cloud.google.com > APIs & Services >
# Credentials). Lets Family Managers search for the home address. Leave unset and the address can't be set.
GOOGLE_PLACES_API_KEY=
# Claude model used to read recipe pages. Defaults to claude-haiku-4-5 (the cheapest).
RECIPE_MODEL=
# Azure Maps key (Azure portal > your Maps account > Authentication). Finds restaurants on the map and works out
# the driving time from the family's home. Leave unset to turn it off; restaurants then have no driving time.
AZURE_MAPS_KEY=
